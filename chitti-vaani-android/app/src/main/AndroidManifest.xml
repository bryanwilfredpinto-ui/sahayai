<?xml version="1.0" encoding="utf-8"?>
<!--
  Chitti Vaani — Phase 2 Android skeleton.

  Permissions are grouped by tier (see CHITTI_VAANI_PHASE2_ANDROID_SPEC.md).
  Each Tier B permission needs runtime prompting; each Tier C role is
  requested via RoleManager only when the user opts into that capability.

  HARD REFUSAL: there is no UNLOCK permission anywhere in this manifest.
  The OS does not expose 3rd-party-app unlock; Chitti's lockNow() has no
  unlockNow() counterpart. This is the technical guarantee, not a promise.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Tier A — install-time -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL"/>
    <!-- Microphone foreground service — Phase 2.4 wake-word loop in
         VaaniBootService. Without this flag the OS kills the recognizer
         once the screen turns off on Android 14+. Bryan 2026-05-22:
         "Background wake word — Hey Chitti always listening." -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Tier B — runtime-prompted -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS"
        tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.READ_CALL_LOG"
        tools:ignore="ProtectedPermissions"/>
    <!-- Outbound calls — direct-dial when granted, else falls back to ACTION_DIAL -->
    <uses-permission android:name="android.permission.CALL_PHONE"/>

    <!-- SMS — heavily restricted on Play Store. Justification:
         "Chitti reads incoming SMS aloud for blind/illiterate users,
          and sends SMS on the user's spoken command via on-screen
          confirmation, identifying as 'Chitti AI on behalf of [user]'." -->
    <uses-permission android:name="android.permission.RECEIVE_SMS"
        tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.READ_SMS"
        tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.SEND_SMS"
        tools:ignore="ProtectedPermissions"/>

    <!-- Tier C — special role / setting / device admin -->
    <uses-permission android:name="android.permission.BIND_DEVICE_ADMIN"
        tools:ignore="ProtectedPermissions"/>

    <!-- Camera — used by openCamera() to launch the system camera app
         (IMAGE_CAPTURE intent), AND by toggleFlashlight() to access the
         torch unit via CameraManager. Bryan 2026-05-22: parity with the
         new media / Android-feature cards on chitti_vaani.html. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.FLASHLIGHT" tools:ignore="UnusedAttribute"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.flash" android:required="false"/>

    <!-- Alarm scheduling — SET_ALARM is normal-protection; the
         ACTION_SET_ALARM intent opens the system Clock app with the
         alarm pre-filled. SCHEDULE_EXACT_ALARM is for WorkManager
         reminder pings (Android 12+). USE_EXACT_ALARM is the
         Android 13+ replacement that doesn't require user opt-in for
         calendar/reminder use cases. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>

    <!-- Location — used for spec §5.3 live location share + nearby
         hospital/chemist Maps category search. We declare both FINE
         and COARSE; runtime asks the user when ChittiNative.shareLocation
         or the Maps category search first fires. Per spec, location is
         NEVER stored — it's read once, packaged as a maps.google.com
         link, and handed to WhatsApp/SMS at the user's spoken "haan". -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Biometric authentication — gates the Keys Vault unlock when the
         user has enrolled a fingerprint / face on the device. The key is
         held in the Android Keystore (TEE-backed) with
         setUserAuthenticationRequired(true) — every unlock requires a
         fresh biometric tap. Normal-protection permission, no runtime
         prompt. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>

    <queries>
        <!-- For "open WhatsApp" deep-links and intent resolution -->
        <package android:name="com.whatsapp"/>
        <package android:name="com.whatsapp.w4b"/>
        <!-- UPI apps for ACTION_VIEW upi://pay -->
        <package android:name="net.one97.paytm"/>
        <package android:name="com.phonepe.app"/>
        <package android:name="com.google.android.apps.nbu.paisa.user"/>
        <package android:name="in.org.npci.upiapp"/>
        <!-- YouTube / YouTube Music / Google Maps — for the new media
             & navigation cards added 2026-05-22. Without these <queries>
             entries, Android 11+ refuses to resolve the targeted Intent
             package and the native open* methods silently fall back to
             web — defeating the parity goal. -->
        <package android:name="com.google.android.youtube"/>
        <package android:name="com.google.android.apps.youtube.music"/>
        <package android:name="com.google.android.apps.maps"/>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="upi"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="vnd.youtube"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="google.navigation"/>
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM"/>
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chitti"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Device Admin: allows lockNow().
             NOTE: there is no public API to UNLOCK the device from a
             3rd-party app. lockNow() has no inverse exposed to us. -->
        <receiver
            android:name=".services.VaaniDeviceAdminReceiver"
            android:label="@string/device_admin_label"
            android:description="@string/device_admin_desc"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin"/>
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED"/>
            </intent-filter>
        </receiver>

        <!-- Call screening — for night-mode auto-answer + emergency wake.
             User must grant the ROLE_CALL_SCREENING role via RoleManager. -->
        <service
            android:name=".services.VaaniCallScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService"/>
            </intent-filter>
        </service>

        <!-- In-call (Default Dialer) — for "answer call as Chitti" flow.
             User must grant ROLE_DIALER. -->
        <service
            android:name=".services.VaaniInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:exported="true">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true"/>
            <intent-filter>
                <action android:name="android.telecom.InCallService"/>
            </intent-filter>
        </service>

        <!-- Accessibility service — autonomous WhatsApp send (locked to that node only).
             User must enable in Settings → Accessibility. -->
        <service
            android:name=".services.VaaniAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>

        <!-- Night-mode boot/alarm receiver — switches into night-mode behaviour at 22:00 IST. -->
        <receiver
            android:name=".services.NightModeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="in.sahayai.chitti.vaani.NIGHT_MODE_TICK"/>
            </intent-filter>
        </receiver>

        <!-- VaaniBootService — Hey-Chitti wake-word foreground service.
             Bryan 2026-05-22: "Background wake word — Hey Chitti always
             listening." The service declares foregroundServiceType =
             "microphone" so the OS allows mic capture while the screen
             is off (Android 14+ rule). The user can stop the loop from
             the persistent notification's "Stop listening" action OR
             via ChittiNative.disableHeyChitti(). -->
        <service
            android:name=".services.VaaniBootService"
            android:exported="false"
            android:foregroundServiceType="microphone"/>

        <!-- VaaniBootReceiver — restarts VaaniBootService on boot if
             the user had Hey-Chitti enabled before the device shut down.
             Reads chitti_vaani_prefs.hey_chitti_enabled — defaults to
             false, so we don't surprise-listen for users who never
             opted in. -->
        <receiver
            android:name=".services.VaaniBootReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

    </application>
</manifest>
