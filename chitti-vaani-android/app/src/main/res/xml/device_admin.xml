<?xml version="1.0" encoding="utf-8"?>
<!--
  Device admin policies Chitti requests.
  Only force-lock is requested. There is no "unlock" policy because
  Android does not expose one to 3rd-party apps.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android"
              android:visible="true">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
