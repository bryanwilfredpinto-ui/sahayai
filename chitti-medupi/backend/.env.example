# Chitti MedUPI - Backend env
# Copy to .env for local dev. On Render, set as service env vars.

# SQLite for local dev; on Render, paste your Neon Postgres connection
# string (format: postgresql://USER:PW@HOST/DB?sslmode=require). All
# MedUPI tables live under the `medupi` schema — see models/_schema.py.
# Schema isolation auto-disables on SQLite (which has no schemas).
DATABASE_URL=sqlite:///./chitti_medupi.db

# Anthropic API key — used for image-based composition extraction (vision)
# Optional: text-only flow works without it.
ANTHROPIC_API_KEY=

# Anthropic model to use for vision extraction
ANTHROPIC_MODEL=claude-sonnet-4-6

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://sahayai.in,https://www.sahayai.in

# Server URL (used in self-references / OpenAPI)
BACKEND_URL=http://localhost:8001

# (Optional) Twilio for phone-call reminders — wires later
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Brave Search API — free 2,000 queries/month. Powers the on-demand
# "live pharmacy price" snippet fetch + the daily 2 AM IST top-100
# refresh. Snippet-only — we never visit pharmacy URLs (no scraping).
# Sign up: https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=

# Scheduler toggle — set to "false" in test environments
SCHEDULER_ENABLED=true

# (Optional) Override the auto-update download URLs without code changes
JAN_AUSHADHI_PRODUCT_URL=
NPPA_CEILING_URL=
