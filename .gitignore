# ── Secrets — NEVER commit these ──
.env
.env.local
.env.*.local
**/.env
**/.env.local
# Railway env paste-files — placeholders only ever lived in git history
# (commit e25c5ed). Once filled with real values, never re-track.
railway-env/*.env

# ── Android release-signing artefacts — NEVER commit ──
# If any of these land in git history the Play Store signing key is
# BURNT and the app can no longer ship updates. See BUILD_APK_RUNBOOK.md.
*.jks
*.keystore
keystore.properties
**/keystore.properties
**/release.jks
**/release.keystore
chitti-vaani-android/app/release/
# Generated APK / AAB artefacts — upload to GH Release, don't track.
*.apk
*.aab

# ── Android per-machine config — NEVER commit ──
# local.properties contains sdk.dir which is machine-specific. Committing
# it breaks every other contributor (their SDK isn't at the same path)
# AND breaks the CI runner (ubuntu-latest doesn't have a Windows SDK path).
# Each dev creates their own local.properties on first checkout; the
# Android Gradle Plugin generates it automatically when you open the
# project in Android Studio. CI uses ANDROID_HOME from setup-android@v3
# and does NOT read local.properties.
local.properties
**/local.properties

# Android build outputs
chitti-vaani-android/**/build/
chitti-vaani-android/**/.gradle/

# ── Python ──
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
venv/

# ── Local SQLite (dev databases) ──
*.db
*.sqlite
*.sqlite3

# ── OS noise ──
.DS_Store
Thumbs.db

# ── Claude Code local config ──
.claude/

# ── Loader download cache (runtime artefacts) ──
chitti-medupi/backend/scripts/data_cache/*
!chitti-medupi/backend/scripts/data_cache/.gitkeep
.turso_dbs.json

# ── Voice Factory fluency: heavy regenerable artefacts ──
# We commit honest_status.json (audit trail), scripts, and the langlinks cache.
# chunks.jsonl, embeddings.npy, FAISS index, and raw PDFs are regenerated on
# Render at deploy time via `python -m scripts.ingest_textbooks && python -m scripts.embed_all`.
chitti-voice-factory/backend/data/fluency/**/_pdfs/
chitti-voice-factory/backend/data/fluency/**/chunks.jsonl
chitti-voice-factory/backend/data/fluency/**/embeddings.npy
chitti-voice-factory/backend/data/fluency/**/index.faiss
node_modules/
