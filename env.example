# ═══════════════════════════════════════════════════
# SAHAY AI — CHITTI BACKEND — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to GitHub
# ═══════════════════════════════════════════════════

# DeepSeek API — The brain
DEEPSEEK_API_KEY=your_deepseek_key_here

# OpenWeatherMap — Free tier, 60 calls/min
# Get from: openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# NewsAPI — Free tier, 100 calls/day
# Get from: newsapi.org
NEWS_API_KEY=your_newsapi_key_here

# Twilio — WhatsApp Business
# Get from: twilio.com/whatsapp
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_WHATSAPP_FROM=+14155238886

# Make.com Webhook — War Room Google Sheets
# Create scenario in make.com, copy webhook URL
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your_webhook_id

# Sire's WhatsApp — Morning Brief recipient
SIRE_WHATSAPP=+919752621332

# Allowed WhatsApp numbers — comma separated
ALLOWED_WHATSAPP_NUMBERS=+919752621332

# Server
PORT=3000
