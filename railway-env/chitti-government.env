# ─────────────────────────────────────────────────────────────────────────
# chitti-government — Railway env (Raw Editor paste)
# Scheme assistant. PIB poll every 6 h. DigiLocker partner-only.
# ─────────────────────────────────────────────────────────────────────────

PYTHON_VERSION=3.11.10
PORT=8003
ALLOWED_ORIGINS=https://sahayai.in,https://www.sahayai.in
BACKEND_URL=https://chitti-government-api.up.railway.app

# ── Turso libSQL (embedded replica) ──
DATABASE_URL=libsql://chitti-government-bryanwilfredpinto.aws-ap-south-1.turso.io?authToken=PASTE_TURSO_TOKEN_HERE
TURSO_AUTH_TOKEN=PASTE_TURSO_TOKEN_HERE
LIBSQL_REPLICA_PATH=/tmp/chitti_government.db

# ── DeepSeek (eligibility coach + scheme explainer) ──
DEEPSEEK_API_KEY=PASTE_DEEPSEEK_KEY_HERE
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MAX_TOKENS=700
DEEPSEEK_TEMPERATURE=0.2

# ── Founder pull ──
FOUNDER_PULL_SECRET=PASTE_FOUNDER_PULL_SECRET_HERE

# ── Nominatim geocoder (1 req/s — UA + email required by policy) ──
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT_EMAIL=chittigovernment@gmail.com
NOMINATIM_USER_AGENT=ChittiGovernment/1.0 (https://sahayai.in/chitti_government.html)

# ── PIB poller (every 6 h) ──
PIB_POLL_HOURS=6
SCHEDULER_ENABLED=true

# ── Email ──
FOUNDER_EMAIL=bryanwilfredpinto@gmail.com
FOUNDER_FROM=chitti@sahayai.in
FOUNDER_SMTP_HOST=smtp.gmail.com
FOUNDER_SMTP_PORT=587
FOUNDER_SMTP_USER=PASTE_GMAIL_ADDR_HERE
FOUNDER_SMTP_PASS=PASTE_GMAIL_APP_PASSWORD_HERE

# ── LLM-judge + swarm ──
EVAL_SAMPLE_RATE=0.10
SWARM_ENABLED=1
SWARM_MIN_CONFIRMATIONS=100
SWARM_THUMBS_UP_RATIO=0.70
CHITTI_CRITICAL_THUMBS_UP_PCT=70
CHITTI_CO2_FLAG_G=0.5
CHITTI_GITHUB_REPO=bryanwilfredpinto-ui/sahayai
FEEDBACK_IP_SALT=PASTE_FOUNDER_PULL_SECRET_HERE
