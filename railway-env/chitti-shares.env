# ─────────────────────────────────────────────────────────────────────────
# chitti-shares — Railway env (Raw Editor paste)
# Bharat-themed agentic technical + fundamental analysis. FastAPI.
# pydantic-settings — JWT_SECRET is REQUIRED (no default), service won't
# boot without it.
# ─────────────────────────────────────────────────────────────────────────

PYTHON_VERSION=3.11.10
PORT=8000
ALLOWED_ORIGINS=https://sahayai.in,https://www.sahayai.in
FRONTEND_URL=https://sahayai.in
BACKEND_URL=https://chitti-shares-api.up.railway.app

# ── Turso libSQL (embedded replica) ──
DATABASE_URL=libsql://chitti-shares-bryanwilfredpinto.aws-ap-south-1.turso.io?authToken=PASTE_TURSO_TOKEN_HERE
TURSO_AUTH_TOKEN=PASTE_TURSO_TOKEN_HERE
LIBSQL_REPLICA_PATH=/tmp/chitti_shares.db

# ── JWT (signs phone-OTP tokens — REQUIRED, no default) ──
JWT_SECRET=PASTE_JWT_SECRET_HERE
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
DEV_MODE_FAKE_OTP=false

# ── Founder pull ──
FOUNDER_PULL_SECRET=PASTE_FOUNDER_PULL_SECRET_HERE

# ── DeepSeek (Story Mode + Chitti Market View + agentic chat_with_tools) ──
DEEPSEEK_API_KEY=PASTE_DEEPSEEK_KEY_HERE
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_URL=https://api.deepseek.com/chat/completions

# ── Admin gate (Sire's mobile, 10 digits no +91) ──
ADMIN_MOBILE=PASTE_ADMIN_MOBILE_HERE

# ── Market data ──
# Yahoo BLOCKED from Render/Railway per project_data_sources memory.
# Use Angel for live prices, screener.in for fundamentals.
DATA_SOURCE=angel
ALERTS_POLL_MINUTES=5
MAX_WATCHLIST_ITEMS=50
MAX_ALERTS_PER_USER=30
DAILY_BUDGET_INR=50
HARD_CAP_INR=100

# ── Angel One (NSE/BSE live — optional, honest stub when blank) ──
ANGEL_API_KEY=PASTE_ANGEL_API_KEY_HERE
ANGEL_CLIENT_CODE=PASTE_ANGEL_CLIENT_CODE_HERE
ANGEL_PIN=PASTE_ANGEL_PIN_HERE
ANGEL_TOTP_SECRET=PASTE_ANGEL_TOTP_SECRET_HERE

# ── Kite Connect (legacy — leave blank, Angel preferred) ──
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=

# ── SMS OTP (Fast2SMS) ──
FAST2SMS_API_KEY=PASTE_FAST2SMS_KEY_HERE

# ── Telegram (Kite re-auth reminder — optional) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Cron secret ──
CRON_SECRET=PASTE_FOUNDER_PULL_SECRET_HERE

# ── Email ──
FOUNDER_EMAIL=bryanwilfredpinto@gmail.com
FOUNDER_FROM=chitti@sahayai.in
FOUNDER_SMTP_HOST=smtp.gmail.com
FOUNDER_SMTP_PORT=587
FOUNDER_SMTP_USER=PASTE_GMAIL_ADDR_HERE
FOUNDER_SMTP_PASS=PASTE_GMAIL_APP_PASSWORD_HERE

# ── LLM-judge + swarm ──
EVAL_SAMPLE_RATE=0.10
SWARM_ENABLED=1
SWARM_MIN_CONFIRMATIONS=100
SWARM_THUMBS_UP_RATIO=0.70
CHITTI_CRITICAL_THUMBS_UP_PCT=70
CHITTI_CO2_FLAG_G=0.5
CHITTI_GITHUB_REPO=bryanwilfredpinto-ui/sahayai
FEEDBACK_IP_SALT=PASTE_FOUNDER_PULL_SECRET_HERE
