# ─────────────────────────────────────────────────────────────────────────
# chitti-founder — Railway env (Raw Editor paste)
# Aggregator + BCP Layer 1. NOT user-facing. No DeepSeek path of its own.
# ─────────────────────────────────────────────────────────────────────────

PYTHON_VERSION=3.11.10
PORT=8010
ALLOWED_ORIGINS=https://sahayai.in,https://www.sahayai.in

# Turso libSQL (embedded replica) — founder's own DB for self-ping history.
DATABASE_URL=libsql://chitti-founder-bryanwilfredpinto.aws-ap-south-1.turso.io?authToken=PASTE_TURSO_TOKEN_HERE
TURSO_AUTH_TOKEN=PASTE_TURSO_TOKEN_HERE
CHITTI_FOUNDER_LIBSQL_URL=libsql://chitti-founder-bryanwilfredpinto.aws-ap-south-1.turso.io?authToken=PASTE_TURSO_TOKEN_HERE
CHITTI_FOUNDER_LIBSQL_LOCAL=/tmp/chitti_founder.db

# Admin auth — header-only, never URL. SAME value in chitti-vaani.env.
ADMIN_SECRET=PASTE_ADMIN_SECRET_HERE
# Bearer that founder presents when pulling /admin/founder/slice from each Chitti.
# SAME value in every other env file in this folder.
FOUNDER_PULL_SECRET=PASTE_FOUNDER_PULL_SECRET_HERE
FOUNDER_PULL_TIMEOUT_S=10

# ── BCP Layer 1 — self-ping cron ──
# Hard OFF during testing per 2026-05-19 directive. Flip to "true" only when
# Sire says GO LIVE. On-demand POST /admin/founder/self-ping still works.
SELF_PING_ENABLED=false
SELF_PING_INTERVAL_MIN=4
SELF_PING_TIMEOUT_S=6
HEALTH_ALERT_COOLDOWN_S=3600

# Endpoints founder pings + pulls slices from.
CHITTI_ENDPOINTS=https://chitti-vaani-api.up.railway.app,https://chitti-medupi-api.up.railway.app,https://chitti-legal-api.up.railway.app,https://chitti-ca-api.up.railway.app,https://chitti-government-api.up.railway.app,https://chitti-news-api.up.railway.app,https://chitti-shares-api.up.railway.app,https://chitti-voice-factory-api.onrender.com

# ── Cron schedule ──
FOUNDER_REPORT_HOUR_IST=7
FOUNDER_REPORT_MINUTE_IST=0
WEEKLY_REPORT_HOUR_IST=8
WEEKLY_REPORT_MINUTE_IST=0

# ── Email (founder daily/weekly/escalator) ──
FOUNDER_EMAIL=bryanwilfredpinto@gmail.com
FOUNDER_FROM=chitti@sahayai.in
FOUNDER_SMTP_HOST=smtp.gmail.com
FOUNDER_SMTP_PORT=587
FOUNDER_SMTP_USER=PASTE_GMAIL_ADDR_HERE
FOUNDER_SMTP_PASS=PASTE_GMAIL_APP_PASSWORD_HERE

# ── Escalator thresholds ──
CHITTI_CRITICAL_THUMBS_UP_PCT=70
CHITTI_CO2_FLAG_G=0.5

# ── GitHub issue opener (optional — leave blank for honest stub) ──
CHITTI_GITHUB_REPO=bryanwilfredpinto-ui/sahayai
CHITTI_GITHUB_TOKEN=PASTE_GITHUB_TOKEN_HERE

# ── SMS alerts (optional — leave blank for honest stub) ──
CHITTI_SMS_URL=PASTE_SMS_URL_HERE
CHITTI_SMS_KEY=PASTE_SMS_KEY_HERE
CHITTI_SIRE_PHONE=PASTE_SIRE_PHONE_HERE

# ── Swarm Intelligence (Sunday 08:00 IST, inline in weekly digest) ──
SWARM_ENABLED=1
SWARM_MIN_CONFIRMATIONS=100
SWARM_THUMBS_UP_RATIO=0.70
SWARM_SAMPLE_PATTERNS_PER_CHITTI=3
# Optional: per-Chitti libSQL URLs let founder's weekly swarm pass mine
# each DB. Leave blank for now — swarm no-ops cleanly when none are set.
# Each one expects libsql://<host>?authToken=<token>
CHITTI_MEDUPI_LIBSQL_URL=
CHITTI_VAANI_LIBSQL_URL=
CHITTI_NEWS_LIBSQL_URL=
CHITTI_GOVERNMENT_LIBSQL_URL=
CHITTI_CA_LIBSQL_URL=
CHITTI_LEGAL_LIBSQL_URL=
CHITTI_SHARES_LIBSQL_URL=

# ── LLM-judge (samples 10% of responses across all Chittis) ──
DEEPSEEK_API_KEY=PASTE_DEEPSEEK_KEY_HERE
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_URL=https://api.deepseek.com/chat/completions
EVAL_SAMPLE_RATE=0.10

# ── Feedback IP hash salt ──
FEEDBACK_IP_SALT=PASTE_FOUNDER_PULL_SECRET_HERE
