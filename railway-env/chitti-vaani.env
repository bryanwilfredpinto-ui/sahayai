# ─────────────────────────────────────────────────────────────────────────
# chitti-vaani — Railway env (Raw Editor paste)
# USER-CANONICAL surface per SAHAYAI_MASTER.md §2 row 1. Routes every
# Chitti capability through one voice-first dost.
# ─────────────────────────────────────────────────────────────────────────

PYTHON_VERSION=3.11.10
PORT=8003
ALLOWED_ORIGINS=https://sahayai.in,https://www.sahayai.in

# ── Turso libSQL (embedded replica) ──
DATABASE_URL=libsql://chitti-vaani-bryanwilfredpinto.aws-ap-south-1.turso.io?authToken=PASTE_TURSO_TOKEN_HERE
TURSO_AUTH_TOKEN=PASTE_TURSO_TOKEN_HERE
ADMIN_DATABASE_URL=libsql://chitti-vaani-bryanwilfredpinto.aws-ap-south-1.turso.io?authToken=PASTE_TURSO_TOKEN_HERE
FEEDBACK_DATABASE_URL=libsql://chitti-vaani-bryanwilfredpinto.aws-ap-south-1.turso.io?authToken=PASTE_TURSO_TOKEN_HERE
LIBSQL_REPLICA_PATH=/tmp/chitti_vaani.db

# ── DeepSeek (sole LLM provider) ──
DEEPSEEK_API_KEY=PASTE_DEEPSEEK_KEY_HERE
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_URL=https://api.deepseek.com/chat/completions
VAANI_MAX_TOKENS=600
VAANI_TEMPERATURE=0.4

# ── Admin auth ── (SAME value as chitti-founder.env ADMIN_SECRET)
ADMIN_SECRET=PASTE_ADMIN_SECRET_HERE
ADMIN_NOTIFY_EMAIL=bryanwilfredpinto@gmail.com

# Founder pull (SAME value across every Chitti)
FOUNDER_PULL_SECRET=PASTE_FOUNDER_PULL_SECRET_HERE

# ── Vaani always-on check-in ──
VAANI_CHECKIN_PROMPT_INTERVAL_MIN=5
VAANI_CHECKIN_MAX_PROMPTS=3

# ── Telephony provider (optional — honest stub when blank) ──
CHITTI_TELEPHONY_PROVIDER=
CHITTI_MISSED_CALL_SECRET=PASTE_FOUNDER_PULL_SECRET_HERE

# ── Gmail OAuth for admin email-token store (optional) ──
GOOGLE_CLIENT_ID=PASTE_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=PASTE_GOOGLE_CLIENT_SECRET_HERE

# ── Admin scheduler (monthly keepalive — 1st of month, 06:00 IST) ──
ADMIN_SCHEDULER_ENABLED=true
ADMIN_KEEPALIVE_DAY=1
ADMIN_KEEPALIVE_HOUR=6
ADMIN_KEEPALIVE_MINUTE=0
ADMIN_SEED_DEFAULTS=true

# ── Feedback scheduler (daily 06:00 IST) ──
FEEDBACK_SCHEDULER_ENABLED=true
FEEDBACK_REPORT_HOUR=6
FEEDBACK_REPORT_MINUTE=0
FEEDBACK_IP_SALT=PASTE_FOUNDER_PULL_SECRET_HERE

# ── Email (per-Chitti report fan-in) ──
FOUNDER_EMAIL=bryanwilfredpinto@gmail.com
FOUNDER_FROM=chitti@sahayai.in
FOUNDER_SMTP_HOST=smtp.gmail.com
FOUNDER_SMTP_PORT=587
FOUNDER_SMTP_USER=PASTE_GMAIL_ADDR_HERE
FOUNDER_SMTP_PASS=PASTE_GMAIL_APP_PASSWORD_HERE

# ── LLM-judge ──
EVAL_SAMPLE_RATE=0.10

# ── Swarm + escalator thresholds ──
SWARM_ENABLED=1
SWARM_MIN_CONFIRMATIONS=100
SWARM_THUMBS_UP_RATIO=0.70
CHITTI_CRITICAL_THUMBS_UP_PCT=70
CHITTI_CO2_FLAG_G=0.5
CHITTI_GITHUB_REPO=bryanwilfredpinto-ui/sahayai
