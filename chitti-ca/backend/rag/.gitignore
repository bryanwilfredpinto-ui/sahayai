# Downloaded official PDFs are large + republished often — fetch with
# `python -m rag.ingest --download`, don't commit them. The seed *.md corpus IS committed.
corpus/*.pdf

# ChromaDB binary store (built locally / on deploy). The small pure-python
# fallback index (index/fallback.jsonl) IS committed so the app works out-of-the-box.
index/chroma.sqlite3
index/*/
!index/fallback.jsonl
