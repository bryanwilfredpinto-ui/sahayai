# Chitti News - Backend env
# Copy to .env locally; on Render, set as service env vars.
# All MedUPI/Shares/News tables share one Postgres, isolated by schema.

# On Render: paste the same Supabase URL the other services use.
# Local dev: SQLite is fine.
DATABASE_URL=sqlite:///./chitti_news.db

# Anthropic — drives "Chitti's Take" summaries + fact-check rationale.
# Optional at runtime: without it, summary endpoint returns "unconfigured".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# CORS — comma-separated frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8002,https://sahayai.in,https://www.sahayai.in
BACKEND_URL=http://localhost:8002

# Scheduler — set to false to disable RSS polling in test runs
SCHEDULER_ENABLED=true

# RSS poll cadence (minutes). Most outlets update every 10-30 min.
RSS_POLL_MINUTES=30

# Optional: Brave Search for breaking-news cross-reference (free 2,000 q/mo)
BRAVE_SEARCH_API_KEY=
